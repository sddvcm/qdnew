# 复制此文件为 .env 并修改
#
#   cp .env.example .env
#
# 或者直接用命令生成一个随机密钥：
#   echo "CHECKIN_SECRET_KEY=$(openssl rand -hex 32)" > .env

# ============ 加密密钥（必须修改）============
# 用于加密存储任务里的账号密码和 Cookie（AES-256-CBC）。
# ⚠️ 一旦设置并开始使用后**不要更改**，改了会导致已存的密码解不出来。
# ⚠️ 不要泄露：拿到它 + 拿到 data/checkin.db 就能解出你的所有账号密码。
CHECKIN_SECRET_KEY=change-me-to-a-random-string

# ============ 可选 ============
# 如果 NAS 上需要走代理访问 GitHub / 推送服务，填代理地址；不需要就留空
# NO_PROXY=http://192.168.1.2:7890
NO_PROXY=
