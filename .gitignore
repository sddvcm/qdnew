# ===== 绝对不要提交的东西 =====
# 加密密钥（泄露 = 数据库里的密码/Cookie 可被解密）
.env
# 但模板要提交，别人才知道怎么配
!.env.example

# SQLite 数据库（含任务配置、加密后的账号密码、签到记录）
data/
*.db
*.db-wal
*.db-shm

# 用户自己导入的插件（属于个人配置，不是项目代码）
user_plugins/*.py
!user_plugins/__init__.py

# 日志
logs/
*.log

# Python 缓存
__pycache__/
*.py[cod]
*$py.class
*.so

# 虚拟环境
venv/
.venv/
env/
ENV/

# IDE / 编辑器
.vscode/
.idea/
*.swp
*.swo
*~

# 系统文件
.DS_Store
Thumbs.db
desktop.ini

# 测试临时产物
__har_test/*.txt
__ref_*/
__verify_*/

# 本地凭据（推送用的 token 等）
GitHub API.txt
gh_token.txt
token.txt

# ---- fpk 打包产物（数百 MB，不进 git）----
packaging/fnos/build/
packaging/fnos/dist/
packaging/fnos/*.log

# 旧的打包目录（早期脚本用过 packaging/build/，现已统一到 fnos/build/）
# 这里可能有 70MB+ 的 python-runtime.tar.gz，绝不能进 git
packaging/build/
*.tar.gz

# ---- fpk 打包：fnpack 项目目录与中间产物 ----
packaging/fnos/build/fnpack_src/
packaging/fnos/build/payload/
packaging/fnos/build/*.tar
packaging/fnos/build/wheels/
packaging/fnos/build/app.tgz
packaging/fnos/*.log
packaging/fnos/tools/fnpack.exe
