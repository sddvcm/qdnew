#!/bin/bash
# 签到管理系统 — 启动 / 停止 / 状态
# 由飞牛 fnOS 调用：cmd/main start|stop|status
# 退出码：start/stop 0=成功 1=失败；status 0=运行中 3=未运行

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=common.sh
source "$SCRIPT_DIR/common.sh"

start_app() {
    ensure_dirs
    # 老版本数据在私有目录 —— 若共享目录可用则搬过去（幂等）
    migrate_legacy_data
    # ★ 清字节码缓存：在线更新换了 .py 但 .pyc 可能仍是旧的，
    #   Python 靠 mtime+size 判断缓存有效性，秒级精度下小改动会误判 →
    #   按旧字节码执行、新源码不生效 → 启动即崩（用户实测踩过）。
    #   启动前清一次，保证每次都是新代码。
    purge_pycache
    if is_running; then
        log_msg "start: 已在运行"
        return 0
    fi

    # 运行时缺失时尝试自愈（升级脚本漏了/手动覆盖过目录）
    if [ ! -x "$PY_BIN" ]; then
        extract_runtime || return 1
    fi

    load_env_file

    # 明确记录数据落点，便于排查"数据在哪"
    log_msg "start: 数据目录=$DATA_ROOT（来源=$DATA_ROOT_SRC）"
    log_msg "start: 启动 (port=${APP_PORT:-$DEFAULT_PORT})"
    cd "$APP_DIR" || return 1

    # ⚠️ 两个关键点，缺一个都会造成"日志文件是空的"（用户实际踩过）：
    #
    # 1. `PYTHONUNBUFFERED=1`
    #    重定向到文件时 Python 的 stdout 是**块缓冲**（4/8KB）。进程启动到
    #    一半崩了、或输出不足一个缓冲区时，内容**根本不会落盘** → 日志 0 字节。
    #    上报错信息也就没了，用户看到"启动失败"却无任何线索。
    #
    # 2. `-u` 同样效果（双保险，环境变量在 nohup 下有时继承不到）
    #    另外把 stderr 也并进来，Werkzeug 的启动/异常栈都在 stderr。
    PORT="${APP_PORT:-$DEFAULT_PORT}" \
    CHECKIN_SECRET_KEY="${CHECKIN_SECRET_KEY:-}" \
    CHECKIN_DATA_DIR="$DATA_DIR" \
    CHECKIN_DATA_DIR_SRC="$DATA_ROOT_SRC" \
    CHECKIN_USER_PLUGINS_DIR="$USER_PLUGINS_DIR" \
    CHECKIN_LOG_DIR="$LOG_DIR" \
    CHECKIN_ETC_DIR="$ETC_DIR" \
    PYTHONUNBUFFERED=1 \
    nohup "$PY_BIN" -u -m app.main >> "$LOG_FILE" 2>&1 &
    local pid=$!
    echo "$pid" > "$PID_FILE"

    # 等待进程稳定（Flask 启动 + APScheduler 初始化）
    local i=0
    while [ $i -lt 10 ]; do
        if ! kill -0 "$pid" 2>/dev/null; then
            log_msg "start: 进程启动即退出（详见 $LOG_FILE）"
            # 把日志末尾带给用户 —— 装机失败提示里只说"去看日志"，
            # 用户还得自己去翻；直接给最后几行能省一轮来回。
            local tail_log=""
            [ -f "$LOG_FILE" ] && tail_log=$(tail -n 15 "$LOG_FILE" 2>/dev/null)
            {
                echo "应用启动失败。日志：$LOG_FILE"
                [ -n "$tail_log" ] && { echo "---- 日志末尾 ----"; echo "$tail_log"; }
            } > "${TRIM_TEMP_LOGFILE:-/dev/stderr}"
            rm -f "$PID_FILE"
            return 1
        fi
        sleep 1
        i=$((i + 1))
    done
    log_msg "start: 已启动 (PID=$pid)"
    return 0
}

stop_app() {
    local pid=""
    if [ -f "$PID_FILE" ]; then
        pid=$(head -n 1 "$PID_FILE" 2>/dev/null | tr -d '[:space:]')
        if ! kill -0 "$pid" 2>/dev/null; then
            pid=""
        fi
    fi
    if [ -z "$pid" ]; then
        pid=$(find_running_pid)
    fi
    if [ -z "$pid" ]; then
        rm -f "$PID_FILE"
        return 0
    fi

    log_msg "stop: SIGTERM -> $pid"
    kill -TERM "$pid" 2>/dev/null
    local i=0
    while kill -0 "$pid" 2>/dev/null && [ $i -lt 10 ]; do
        sleep 1
        i=$((i + 1))
    done
    if kill -0 "$pid" 2>/dev/null; then
        log_msg "stop: SIGKILL -> $pid"
        kill -KILL "$pid" 2>/dev/null
        sleep 1
    fi
    rm -f "$PID_FILE"
    return 0
}

case "$1" in
    start)
        start_app
        ;;
    stop)
        stop_app
        ;;
    status)
        if is_running; then
            exit 0
        fi
        # 自愈：PID 文件丢失但进程实际还在（如 var 目录被清过）
        pid=$(find_running_pid)
        if [ -n "$pid" ]; then
            echo "$pid" > "$PID_FILE"
            exit 0
        fi
        exit 3
        ;;
    *)
        echo "Usage: $0 {start|stop|status}" >&2
        exit 1
        ;;
esac
