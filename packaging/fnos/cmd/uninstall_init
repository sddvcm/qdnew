#!/bin/bash
# 卸载前执行：停掉应用（fnOS 通常也会先停，这里是双保险）
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
source "$SCRIPT_DIR/common.sh" 2>/dev/null

if [ -f "$PID_FILE" ]; then
    pid=$(head -n 1 "$PID_FILE" 2>/dev/null | tr -d '[:space:]')
    [ -n "$pid" ] && kill -TERM "$pid" 2>/dev/null
    rm -f "$PID_FILE"
fi
# 兜底清掉漏网进程
p=$(find_running_pid)
[ -n "$p" ] && kill -TERM "$p" 2>/dev/null

exit 0
